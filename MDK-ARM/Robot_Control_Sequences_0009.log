[19:07:55.590]              // -> [pidr2 <= 0x0000000A]
[19:07:55.591]            jep106id = ((pidr2 & 0x7) << 4 ) | ((pidr1 >> 4) & 0xF);
[19:07:55.591]              // -> [jep106id <= 0x00000020]
[19:07:55.591]          </block>
[19:07:55.591]          <control if="jep106id != 0x20" while="" timeout="0" info="">
