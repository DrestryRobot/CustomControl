[19:07:55.585]            pidr1 = Read32(ROMTableBase + 0x0FE4);
[19:07:55.588]              // -> [Read32(0xE00FFFE4) => 0x00000004] (__dp=0, __ap=0)
[19:07:55.588]              // -> [pidr1 <= 0x00000004]
[19:07:55.588]            pidr2 = Read32(ROMTableBase + 0x0FE8);
