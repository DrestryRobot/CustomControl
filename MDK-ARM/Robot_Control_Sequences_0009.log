[19:07:55.583]            __ap = 0;      // AHB-AP
[19:07:55.583]              // -> [__ap <= 0x00000000]
[19:07:55.583]            ROMTableBase = ReadAP(0xF8) & ~0x3;
[19:07:55.585]              // -> [ReadAP(0x000000F8) => 0xE00FF003] (__dp=0, __ap=0)
